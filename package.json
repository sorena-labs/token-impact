{
  "name": "token-impact",
  "version": "0.1.0",
  "description": "Lists the design tokens a change touches, following aliases and modes, and the CSS, Dart, Swift or TypeScript files that use them.",
  "keywords": [
    "design-tokens",
    "dtcg",
    "style-dictionary",
    "css-variables",
    "visual-regression",
    "impact-analysis",
    "flutter",
    "cli"
  ],
  "license": "MIT",
  "author": "Sorena Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorena-labs/token-impact.git"
  },
  "bugs": "https://github.com/sorena-labs/token-impact/issues",
  "homepage": "https://github.com/sorena-labs/token-impact#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "token-impact": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
